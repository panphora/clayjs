{
  "name": "@panphora/clayjs",
  "version": "1.15.2",
  "type": "module",
  "description": "clayjs: malleable documents. Save lifecycle for self-saving HTML.",
  "license": "MIT-0",
  "homepage": "https://clayjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panphora/clayjs.git"
  },
  "bugs": {
    "url": "https://github.com/panphora/clayjs/issues"
  },
  "keywords": [
    "html",
    "self-saving",
    "malleable",
    "local-first",
    "no-build",
    "contenteditable",
    "dom",
    "autosave",
    "single-file",
    "static-site",
    "vanilla-javascript",
    "html-editor"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./THIRD-PARTY-NOTICES.md": "./THIRD-PARTY-NOTICES.md",
    "./guide.md": "./docs/guide.md",
    "./src/*": "./src/*",
    "./entries/*": "./entries/*",
    "./clay.standalone.js": "./dist/clay.standalone.js",
    "./tailwind": "./src/tailwind.js",
    "./page/yjs": "./src/page/ybind/external.js",
    "./dist/*": "./dist/*",
    "./server/rooms": {
      "import": "./dist/server/rooms.mjs",
      "require": "./dist/server/rooms.cjs"
    },
    "./server/checkpoint": {
      "import": "./dist/server/checkpoint.mjs",
      "require": "./dist/server/checkpoint.cjs"
    },
    "./*": "./entries/*"
  },
  "files": [
    "packed-contract.json",
    "entries/",
    "dist/",
    "THIRD-PARTY-NOTICES.md",
    "docs/guide.md",
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/test-guard.mjs",
    "measure:load": "node scripts/measure-load.mjs",
    "test:conformance": "UPDATE_GOLDENS=0 web-test-runner --config conformance/wtr.config.mjs",
    "conformance:update": "UPDATE_GOLDENS=1 web-test-runner --config conformance/wtr.config.mjs",
    "build:standalone": "node build.js --standalone",
    "prepack": "node build.js --standalone",
    "test:standalone": "node build.js --standalone && web-test-runner --config tests/browser/wtr.config.mjs",
    "prepublishOnly": "testbox run",
    "dev": "node tests/stub-server.mjs",
    "build": "npm run build:bevel && npm run build:skins && node build.js",
    "propagate:foundation": "node scripts/propagate-foundation.mjs",
    "check:foundation": "node scripts/propagate-foundation.mjs --check",
    "deploy": "node build.js && wrangler deploy && git rev-parse HEAD > .deploy",
    "build:parse5": "node scripts/build-parse5-vendor.mjs",
    "build:prosemirror": "node scripts/build-prosemirror-vendor.mjs",
    "build:yjs": "node scripts/build-yjs-vendor.mjs",
    "build:bevel": "node scripts/build-bevel-subset.mjs",
    "check:bevel": "node scripts/build-bevel-subset.mjs --check",
    "build:skins": "node scripts/build-vendor-skins.mjs",
    "check:skins": "node scripts/build-vendor-skins.mjs --check",
    "vendor:optional": "node scripts/vendor-optional.mjs",
    "check:vendor-optional": "node scripts/vendor-optional.mjs --check"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@panphora/bevel": "0.1.0",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.1",
    "cheerio": "1.2.0",
    "esbuild": "^0.28.2",
    "highlight.js": "11.9.0",
    "hyper-morph": "1.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "lib0": "0.2.119",
    "marked": "18.0.14",
    "overtype": "2.6.1",
    "parse5": "^7.3.0",
    "playwright": "1.62.1",
    "postcss": "^8.5.28",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yjs": "13.6.27"
  },
  "hyper": {
    "kind": "lib",
    "status": "active",
    "url": "https://clayjs.com"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "transform": {},
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ]
  }
}
