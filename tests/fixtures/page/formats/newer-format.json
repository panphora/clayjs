{
  "name": "newer-format",
  "writer": "fixture newer writer (newer-writer.mjs)",
  "floor": 1,
  "keeps": ["a", "t", "h"],
  "neighbour": { "id": "z", "c": "Neighbour line", "add": " edited" },
  "blocks": {
    "a": {
      "t": "paragraph",
      "pos": "00000001",
      "c": "Ada Lovelace wrote this",
