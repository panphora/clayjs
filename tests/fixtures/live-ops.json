[
  { "name": "set a new key", "before": {}, "ops": [{ "op": "set", "path": ["a"], "value": 1 }], "after": { "a": 1 } },
  { "name": "set replaces and keeps key order", "before": { "a": 1, "b": 2 }, "ops": [{ "op": "set", "path": ["a"], "value": 9 }], "after": { "a": 9, "b": 2 } },
  { "name": "set creates objects on the way", "before": {}, "ops": [{ "op": "set", "path": ["p", "alice", "x"], "value": 3 }], "after": { "p": { "alice": { "x": 3 } } } },
  { "name": "set creates a list when the next step is an index", "before": {}, "ops": [{ "op": "set", "path": ["grid", 0], "value": 5 }], "after": { "grid": [5] } },
  { "name": "set replaces a non-container on the way", "before": { "p": 5 }, "ops": [{ "op": "set", "path": ["p", "x"], "value": 1 }], "after": { "p": { "x": 1 } } },
  { "name": "set a list cell", "before": { "g": [[0, 0], [0, 0]] }, "ops": [{ "op": "set", "path": ["g", 1, 0], "value": 7 }], "after": { "g": [[0, 0], [7, 0]] } },
  { "name": "set appends at the list end", "before": { "l": [1] }, "ops": [{ "op": "set", "path": ["l", 1], "value": 2 }], "after": { "l": [1, 2] } },
  { "name": "set past the list end throws", "before": { "l": [1] }, "ops": [{ "op": "set", "path": ["l", 3], "value": 2 }], "throws": "RangeError" },
  { "name": "a string key on a list throws", "before": { "l": [1] }, "ops": [{ "op": "set", "path": ["l", "x"], "value": 2 }], "throws": "TypeError" },
  { "name": "a canonical integer string indexes a list", "before": { "l": [1, 2] }, "ops": [{ "op": "set", "path": ["l", "1"], "value": 9 }], "after": { "l": [1, 9] } },
  { "name": "an integer segment on an object is a key", "before": { "o": {} }, "ops": [{ "op": "set", "path": ["o", 0], "value": "z" }], "after": { "o": { "0": "z" } } },
  { "name": "set the whole value", "before": { "a": 1 }, "ops": [{ "op": "set", "path": [], "value": { "b": 2 } }], "after": { "b": 2 } },
  { "name": "del a key", "before": { "a": 1, "b": 2 }, "ops": [{ "op": "del", "path": ["a"] }], "after": { "b": 2 } },
  { "name": "del a missing key is a no-op", "before": { "a": 1 }, "ops": [{ "op": "del", "path": ["x", "y"] }], "after": { "a": 1 } },
  { "name": "del a list item shifts the rest", "before": { "l": ["a", "b", "c"] }, "ops": [{ "op": "del", "path": ["l", 0] }], "after": { "l": ["b", "c"] } },
  { "name": "del past the list end is a no-op", "before": { "l": ["a"] }, "ops": [{ "op": "del", "path": ["l", 5] }], "after": { "l": ["a"] } },
  { "name": "del then set moves the key to the end", "before": { "a": 1, "b": 2 }, "ops": [{ "op": "del", "path": ["a"] }, { "op": "set", "path": ["a"], "value": 3 }], "after": { "b": 2, "a": 3 } },
  { "name": "add to a number", "before": { "s": 5 }, "ops": [{ "op": "add", "path": ["s"], "n": 2 }], "after": { "s": 7 } },
  { "name": "add to a missing key starts at zero", "before": {}, "ops": [{ "op": "add", "path": ["t", "s"], "n": 1 }], "after": { "t": { "s": 1 } } },
  { "name": "add to a non-number starts at zero", "before": { "s": "x" }, "ops": [{ "op": "add", "path": ["s"], "n": 4 }], "after": { "s": 4 } },
  { "name": "two adds both count", "before": { "s": 0 }, "ops": [{ "op": "add", "path": ["s"], "n": 1 }, { "op": "add", "path": ["s"], "n": 1 }], "after": { "s": 2 } },
  { "name": "negative add", "before": { "s": 3 }, "ops": [{ "op": "add", "path": ["s"], "n": -5 }], "after": { "s": -2 } },
  { "name": "set then add", "before": { "s": 9 }, "ops": [{ "op": "set", "path": ["s"], "value": 1 }, { "op": "add", "path": ["s"], "n": 1 }], "after": { "s": 2 } },
  { "name": "add then set", "before": { "s": 9 }, "ops": [{ "op": "add", "path": ["s"], "n": 1 }, { "op": "set", "path": ["s"], "value": 1 }], "after": { "s": 1 } },
  { "name": "a later op sees an earlier one", "before": {}, "ops": [{ "op": "set", "path": ["p"], "value": { "a": { "x": 0 } } }, { "op": "set", "path": ["p", "a", "x"], "value": 4 }], "after": { "p": { "a": { "x": 4 } } } },
  { "name": "a key named __proto__ is an ordinary key", "before": {}, "ops": [{ "op": "set", "path": ["__proto__"], "value": { "polluted": true } }], "after": { "__proto__": { "polluted": true } } }
]
