{
  "schema": 1,
  "id": "tagless-first-write",
  "fixture": "page-host",
  "boot": { "mode": "edit", "live": true, "destination": "host" },
  "steps": [
    { "op": "settle", "ms": 200 },
    { "op": "input", "target": ".ProseMirror", "value": "First edit" },
    { "op": "leave", "await": false },
    { "op": "settle", "ms": 200 }
  ],
  "requires": ["input-admitted", "save-request-sent"],
  "expect": {
    "mode": "view",
    "saves": [
      { "path": "/_/save", "contains": "First edit" },
      { "path": "/_/live-sync/save", "relayOf": 0 }
    ]
  }
}
